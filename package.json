{
  "name": "weather-and-air",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.23",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "3.9.10",
    "tsx": "latest",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "build:android": "expo run:android --variant debug --no-bundler",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint"
  },
  "private": true,
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
